# Generated at container start by run.sh — do not edit this file directly
# inside the running container, your edits will be overwritten on the next
# restart. Change values via the HA apps "Configuration" tab instead.
#
# use_default_settings: true means SearXNG loads its full built-in engine
# catalog first, then applies only the overrides below on top of it. That's
# what lets us toggle individual engines without maintaining the whole list.
use_default_settings: true

general:
  instance_name: "${INSTANCE_NAME}"

server:
  secret_key: "${SECRET_KEY}"
  base_url: "${BASE_URL}"
  bind_address: "0.0.0.0"
  port: ${PORT}
  limiter: false

search:
  safesearch: ${SAFESEARCH}
  formats:
    - html
    - json
